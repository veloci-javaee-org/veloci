<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Shop | Veloci</title>
<style>*{box-sizing:border-box}body{margin:0;background:#f7f7f5;color:#171717;font-family:Arial,Helvetica,sans-serif}a{text-decoration:none;color:inherit}.navbar{height:72px;padding:0 7%;display:flex;align-items:center;justify-content:space-between;background:#fff;border-bottom:1px solid #eee}.logo{font-size:27px;font-weight:800;letter-spacing:-1px}.logo span{font-weight:400}.nav-links,.actions{display:flex;align-items:center;gap:26px;list-style:none}.nav-links a{color:#555}.actions{gap:16px}.profile-menu{position:relative}.profile-menu summary{list-style:none;cursor:pointer}.profile-menu summary::-webkit-details-marker{display:none}.profile-options{position:absolute;right:0;top:calc(100% + 10px);z-index:5;min-width:165px;padding:8px;background:#fff;border:1px solid #eee;border-radius:9px;box-shadow:0 8px 24px #0002}.profile-options a,.profile-options button{display:block;width:100%;padding:10px;border:0;background:none;text-align:left;font:inherit;cursor:pointer}.profile-options a:hover,.profile-options button:hover{background:#f5f5f2}.button{display:inline-block;padding:11px 17px;border-radius:7px;background:#171717;color:white;border:0;font-weight:600;cursor:pointer}.button.light{background:#fff;color:#171717;border:1px solid #ccc}.wrap{max-width:1200px;margin:0 auto;padding:45px 24px}.heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:26px}.heading h1{font-size:42px;letter-spacing:-2px;margin:0 0 8px}.heading p{color:#666;margin:0}.filters{display:flex;gap:12px;flex-wrap:wrap;background:#fff;border:1px solid #eee;border-radius:12px;padding:18px;margin-bottom:28px}.filters input,.filters select{min-height:42px;padding:0 12px;border:1px solid #ddd;border-radius:7px;background:#fff;font:inherit}.filters input[type=search]{flex:1;min-width:200px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(245px,1fr));gap:20px}.card{background:#fff;border:1px solid #eee;border-radius:12px;padding:14px;transition:.2s}.card:hover{transform:translateY(-3px);box-shadow:0 12px 28px #17171712}.card img{width:100%;height:260px;object-fit:cover;border-radius:8px;background:#e9e8e3}.card h2{font-size:19px;margin:14px 0 5px}.muted{color:#777;font-size:14px}.price{font-size:19px;font-weight:700;margin:12px 0}.empty{padding:45px;text-align:center;background:#fff;border-radius:12px;color:#666}@media(max-width:680px){.navbar{padding:0 18px}.nav-links{gap:12px}.nav-links li:nth-child(3){display:none}.heading{display:block}.heading h1{font-size:34px}}
</style></head><body>
<header class="navbar"><a href="${pageContext.request.contextPath}/index.jsp" class="logo">velo<span>ci</span></a><ul class="nav-links"><li><a href="${pageContext.request.contextPath}/index.jsp">Home</a></li><li><a href="${pageContext.request.contextPath}/products">Shop</a></li><li><a href="${pageContext.request.contextPath}/products?category=Clothing">Clothing</a></li></ul><div class="actions"><c:choose><c:when test="${not empty sessionScope.username}"><a href="${pageContext.request.contextPath}/cart">Cart</a><details class="profile-menu"><summary class="button">Profile</summary><div class="profile-options"><a href="${pageContext.request.contextPath}/profile">My profile</a><a href="${pageContext.request.contextPath}/orders">My orders</a><form action="${pageContext.request.contextPath}/logout" method="post"><button type="submit">Log out</button></form></div></details></c:when><c:otherwise><a href="${pageContext.request.contextPath}/views/login.html" class="button light">Login</a></c:otherwise></c:choose></div></header>
<main class="wrap"><div class="heading"><div><h1>Clothing collection</h1><p>Find your next everyday favorite.</p></div><a class="button light" href="${pageContext.request.contextPath}/index.jsp">← Home</a></div>
<form class="filters" action="${pageContext.request.contextPath}/products" method="get"><input type="search" name="keyword" placeholder="Search clothing" value="${searchKeyword}"><select name="category"><option value="">All categories</option><option value="Clothing" ${selectedCategory == 'Clothing' ? 'selected' : ''}>Clothing</option></select><select name="sort"><option value="">Sort: featured</option><option value="price_asc" ${sort == 'price_asc' ? 'selected' : ''}>Price: low to high</option><option value="price_desc" ${sort == 'price_desc' ? 'selected' : ''}>Price: high to low</option><option value="name" ${sort == 'name' ? 'selected' : ''}>Name</option></select><button class="button" type="submit">Apply</button><a class="button light" href="${pageContext.request.contextPath}/products">Reset</a></form>
<c:choose><c:when test="${empty products}"><div class="empty">No clothing products found. Try changing your search or filter.</div></c:when><c:otherwise><div class="grid"><c:forEach var="product" items="${products}"><article class="card"><c:choose><c:when test="${not empty product.images}"><img src="${pageContext.request.contextPath}${product.images[0].imagePath}" alt="${product.name}"></c:when><c:otherwise><div class="empty">Product image coming soon</div></c:otherwise></c:choose><p class="muted">${product.category.name}</p><h2>${product.name}</h2><p class="muted">${product.description}</p><p class="price">$<fmt:formatNumber value="${product.price}" pattern="#,##0.00"/></p><a class="button" href="${pageContext.request.contextPath}/product-details?id=${product.id}">Choose size</a></article></c:forEach></div></c:otherwise></c:choose></main></body></html>