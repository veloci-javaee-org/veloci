<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><title>Your Cart | Veloci</title><style>*{box-sizing:border-box}body{margin:0;background:#f7f7f5;color:#171717;font:16px Arial}.bar{padding:22px 7%;background:white;border-bottom:1px solid #eee;display:flex;justify-content:space-between}.brand{font-size:26px;font-weight:bold;text-decoration:none;color:inherit}.wrap{max-width:900px;margin:45px auto;padding:28px;background:#fff;border:1px solid #eee;border-radius:14px}h1{font-size:36px;margin:0 0 25px}.item{display:flex;justify-content:space-between;padding:17px 0;border-bottom:1px solid #eee}.button{display:inline-block;padding:12px 18px;background:#171717;border:0;border-radius:7px;color:#fff;text-decoration:none;cursor:pointer}.total{text-align:right;font-size:21px;font-weight:bold;margin:24px 0}</style></head><body><header class="bar"><a class="brand" href="${pageContext.request.contextPath}/index.jsp">veloci</a><a href="${pageContext.request.contextPath}/products">Continue shopping</a></header><main class="wrap"><h1>Your cart</h1><c:choose><c:when test="${empty cartItems}"><p>Your cart is empty.</p><a class="button" href="${pageContext.request.contextPath}/products">Browse clothing</a></c:when><c:otherwise><c:forEach var="item" items="${cartItems}"><div class="item"><span><strong>${item.product.name}</strong><br>Size ${item.size} · Qty ${item.quantity}</span><span>$<fmt:formatNumber value="${item.lineTotal}" pattern="#,##0.00"/></span></div></c:forEach><div class="total">Total: $<fmt:formatNumber value="${cartTotal}" pattern="#,##0.00"/></div><form method="post" action="${pageContext.request.contextPath}/PlaceOrder"><button class="button" type="submit">Place order</button></form></c:otherwise></c:choose></main></body></html>